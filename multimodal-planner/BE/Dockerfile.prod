# Official Deno image (Debian), pinned so that builds are reproducible
FROM denoland/deno:2.9.8 AS be

# Python is used for the transfer stop scripts (scripts/*.py). The wheels of pandas,
# scikit-learn and kmedoids need no compiler, so --no-install-recommends keeps
# build-essential, perl and the -dev packages out of the image; upgrade pulls Debian
# security fixes newer than the base image.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends procps python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first so that code changes do not invalidate this layer
WORKDIR /app/BE
COPY ./BE/requirements.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt

# Copy backend files
COPY ./BE .

RUN deno install

WORKDIR /app/

COPY ./types ./types

WORKDIR /app/BE

RUN deno cache --allow-import api.ts

EXPOSE 8000

CMD ["python3", "./scripts/initServer.py", "--prod"]
